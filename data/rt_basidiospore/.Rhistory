set_names(stringr::str_extract(basename(.), "\\d+")) %>%
map(function(f) {
specimen_id <- stringr::str_extract(basename(f), "\\d+")
readr::read_csv(f, show_col_types = FALSE) %>%
mutate(
specimen_id = specimen_id,
species = specimen_lookup$species[
match(specimen_id, specimen_lookup$specimen_id)
]
)
})
