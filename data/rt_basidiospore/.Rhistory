setwd("~/Desktop/wiscam_microscopy/data/rt_basidiospore")
library(readr)
library(dplyr)
library(stringr)
# ---- Load specimen → species lookup ----
specimen_lookup <- read_csv("specimen_lookup.csv", show_col_types = FALSE)
# Ensure types are correct
specimen_lookup$specimen_id <- as.character(specimen_lookup$specimen_id)
# ---- Directory with spore CSVs ----
data_dir <- "basidiospore_by_specimen"
csv_files <- list.files(
path = data_dir,
pattern = "_basidiospore\\.csv$",
full.names = TRUE
)
# ---- Container for data frames ----
spore_dfs <- list()
# ---- Explicit for-loop (robust and clear) ----
for (f in csv_files) {
# Extract specimen ID from filename
specimen_id <- str_extract(basename(f), "\\d+")
# Read CSV
df <- read_csv(f, show_col_types = FALSE)
# Look up species
species_name <- specimen_lookup$species[
specimen_lookup$specimen_id == specimen_id
]
# Defensive check
if (length(species_name) == 0) {
warning(paste("No species found for specimen", specimen_id))
species_name <- NA_character_
}
# Add metadata
df <- df %>%
mutate(
specimen_id = specimen_id,
species = species_name
)
# Store in list, named by specimen_id
spore_dfs[[specimen_id]] <- df
}
spore_all <- bind_rows(spore_dfs)
ggplot(spore_all, aes(x = Length, fill = species)) +
geom_histogram(binwidth = 0.5) +
facet_wrap(~ species, scales = "free_y")
spore_summary <- spore_all %>%
group_by(specimen_id, species) %>%
group_modify(~ summarize_spores_one(.x)) %>%
ungroup()
summarize_spores_one <- function(df) {
# Ensure numeric
df <- df %>%
mutate(
Length = as.numeric(Length),
Width  = as.numeric(Width),
Q      = as.numeric(Q)
)
df <- df %>% filter(!is.na(Length) & !is.na(Width))
tibble(
specimen_id = unique(df$specimen_id),
species     = unique(df$species),
spore_count = nrow(df),
min_length  = custom_round(min(df$Length)),
mean_length = mean(df$Length),
p10_length  = custom_round(quantile(df$Length, 0.10)),
p90_length  = custom_round(quantile(df$Length, 0.90)),
max_length  = custom_round(max(df$Length)),
min_width   = custom_round(min(df$Width)),
mean_width  = mean(df$Width),
p10_width   = custom_round(quantile(df$Width, 0.10)),
p90_width   = custom_round(quantile(df$Width, 0.90)),
max_width   = custom_round(max(df$Width)),
min_q       = custom_round(min(df$Q)),
mean_q      = mean(df$Q),
max_q       = custom_round(max(df$Q))
)
}
spore_summary <- spore_all %>%
group_by(specimen_id, species) %>%
group_modify(~ summarize_spores_one(.x)) %>%
ungroup()
View(summarize_spores_one)
View(df)
View(df)
View(specimen_lookup)
View(spore_all)
df <- df %>%
mutate(
Length = as.numeric(Length),
Width  = as.numeric(Width),
Q      = as.numeric(Q (length/width))
)
spore_all <- bind_rows(spore_dfs)
avg_spores <- spore_all %>%
group_by(specimen_id) %>%
summarise(
mean_length = mean(Length, na.rm = TRUE),
mean_width  = mean(Width,  na.rm = TRUE),
.groups = "drop"
)
View(avg_spores)
View(avg_spores)
View(avg_spores)
