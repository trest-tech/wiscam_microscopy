library(dplyr)
library(ggplot2)
library(stringr)
library(readr)
basidia <- read_csv("basidia_filled_rt.csv")
# Filter to specimens with complete basidia length data
all_clean <- basidia %>%
filter(!is.na(min_length),
!is.na(avg_length),
!is.na(max_length))
# Format species names: "Amanita fusca" → "A. fusca"
all_clean <- all_clean %>%
mutate(
species_short = str_replace(species, "^Amanita", "A.")
)
# Reorder species by section first, then species name
all_clean <- all_clean %>%
arrange(sectionid, species_short) %>%
mutate(species_short = factor(species_short, levels = unique(species_short)))
# Section color palette
section_colors <- c(
"Roanokensis" = "magenta",
"Phalloideae" = "blue",
"Vaginatae"   = "yellow",
"Amanita"     = "red",
"Validae"     = "green",
"Caesareae"   = "orange",
"Amidella"    = "purple"
)
# Plot
ggplot(all_clean, aes(x = species_short, color = sectionid)) +
geom_segment(aes(y = min_length, yend = max_length,
xend = species_short), linewidth = 1) +
geom_point(aes(y = avg_length), size = 3) +
scale_color_manual(values = section_colors) +
labs(
title = "Basidia Length Range per Specimen (Sorted by Section)",
x = "Species",
y = "Basidia Length (µm)",
color = "Section"
) +
theme_minimal(base_size = 14) +
theme(
axis.text.x = element_text(angle = 45, hjust = 1, face = "italic")
)
