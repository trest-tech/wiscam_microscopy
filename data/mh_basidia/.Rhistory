library(tidyverse)
library(ggplot2)
library(ggtree)
library(patchwork)
library(tidyr)
basidia <- read_csv("basidia_filled_mh.csv", show_col_types = FALSE)
#Identify sterigma count columns
ster_cols <- c("4s/basidia", "3s/basidia", "2s/basidia", "s/basidia")
#Calculate total basidia observed for each specimen
basidia_totals <- basidia %>%
mutate(
total_basidia = rowSums(across(all_of(ster_cols)), na.rm = TRUE)
) %>%
filter(total_basidia > 0)
#Sum total basidia observed per section
section_totals <- basidia_totals %>%
group_by(sectionid) %>%
summarise(
total_basidia = sum(total_basidia),
n_specimens = n(),
.groups = "drop"
)
section_totals <- section_totals %>%
mutate(sectionid = as.character(sectionid))
#Add missing sections
tree_sections <- sectree_ordered$tip.label
section_totals_full <- section_totals %>%
complete(
sectionid = tree_sections,
fill = list(total_basidia = 0, n_specimens = 0)
)
#Order phylogenetically
phylo_order <- c(
"Lepidella",
"Roanokensis",
"Amidella",
"Strobiloformes",
"Validae",
"Phalloideae",
"Arenariae",
"Amarrendiae",
"Amanita",
"Vaginatae",
"Caesareae"
)
#Plot section totals
ggplot(section_totals_full,
aes(x = sectionid, y = total_basidia, fill = sectionid)) +
geom_col(color = "black") +
geom_text(
aes(label = ifelse(total_basidia > 0, total_basidia, "")),
vjust = -0.3,
size = 3
) +
scale_x_discrete(limits = phylo_order) +
labs(
x = "Amanita Section",
y = "Total basidia observed"
) +
theme_classic() +
theme(
axis.text.x = element_text(angle = 45, hjust = 1)
)
library(tidyverse)
library(ggplot2)
library(ggtree)
library(patchwork)
library(tidyr)
basidia <- read_csv("basidia_filled_mh.csv", show_col_types = FALSE)
#Identify sterigma count columns
ster_cols <- c("4s/basidia", "3s/basidia", "2s/basidia", "s/basidia")
#Calculate total basidia observed for each specimen
basidia_totals <- basidia %>%
mutate(
total_basidia = rowSums(across(all_of(ster_cols)), na.rm = TRUE)
) %>%
filter(total_basidia > 0)
#Sum total basidia observed per section
section_totals <- basidia_totals %>%
group_by(sectionid) %>%
summarise(
total_basidia = sum(total_basidia),
n_specimens = n(),
.groups = "drop"
)
section_totals <- section_totals %>%
mutate(sectionid = as.character(sectionid))
#Add missing sections
tree_sections <- sectree_ordered$tip.label
section_totals_full <- section_totals %>%
complete(
sectionid = tree_sections,
fill = list(total_basidia = 0, n_specimens = 0)
)
#Order phylogenetically
phylo_order <- c(
"Lepidella",
"Roanokensis",
"Amidella",
"Strobiloformes",
"Validae",
"Phalloideae",
"Arenariae",
"Amarrendiae",
"Amanita",
"Vaginatae",
"Caesareae"
)
#Plot section totals
basidia_count <- ggplot(section_totals_full,
aes(x = sectionid, y = total_basidia, fill = sectionid)) +
geom_col(color = "black") +
geom_text(
aes(label = ifelse(total_basidia > 0, total_basidia, "")),
vjust = -0.3,
size = 3
) +
scale_x_discrete(limits = phylo_order) +
labs(
x = "Amanita Section",
y = "Total basidia observed"
) +
theme_classic() +
theme(
axis.text.x = element_text(angle = 45, hjust = 1)
)
ggsave(filename = "basidia_observed.png", plot = basidia_count, width = 10, height = 6, units = "in", dpi = 300)
